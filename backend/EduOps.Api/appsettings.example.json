{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=db;Port=5432;Database=EduOpsDb;Username=postgres;Password=mysecretpassword",
    "Redis": "redis:6379"
  },
  "CloudflareR2": {
    "BucketName": "your-bucket-name",
    "AccountId": "your-account-id",
    "AccessKey": "your-access-key",
    "SecretKey": "your-secret-key",
    "PublicDomain": "https://pub-xxxxxx.r2.dev"
  },
  "JwtSettings": {
    "Secret": "your-256-bit-secret-key-at-least-32-characters-long",
    "Issuer": "EduOpsBackend",
    "Audience": "EduOpsFrontend",
    "AccessTokenExpirationMinutes": "1440"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://your-production-domain.com"
    ]
  },
  "HangfireSettings": {
    "DailyReminderCron": "0 21 * * *"
  },
  "SerilogSettings": {
    "FileSizeLimitBytes": 10485760,
    "RetainedFileCountLimit": 7
  },
  "SePay": {
    "MerchantId": "SP-TEST-XXXXXX",
    "SecretKey": "your-sepay-secret-key",
    "Environment": "sandbox",
    "WebhookToken": "your-webhook-token"
  }
}
